  "stories": [
    {
      "headline": "Mali Land Rebound",
      "summary": "Rokiatu Traor\u00e9 won UN recognition for a Mali agroforestry effort that restores degraded land and creates jobs.",
      "key_points": [
        "Rokiatu Traor\u00e9 was named a Changemaker at the UN Sustainable Development Goals Action Awards.",
        "Herou Alliance works in Mali to restore degraded land and create jobs for women and youths.",
        "Since 2021, the group has built value chains around the moringa tree.",
        "The alliance makes tea, powder, honey, soap, spices, and dietary supplements."
      ],
      "why_it_matters": "It shows degraded rural land can be turned into livelihoods and new local value.",
      "url": "https://news.mongabay.com/short-article/2026/11/malis-moringa-queen-wins-un-recognition-for-restoring-degraded-land/",
      "date": "2026-11-05",
      "image": "https://imgs.mongabay.com/wp-content/uploads/sites/20/2026/11/05180051/10561856364_1b0aab79ee_k-768x512.jpg",
      "source": "Mongabay"
    },
    {
      "headline": "Desa\u2019a Forest Backed",
      "summary": "The UN recognized Ethiopia\u2019s Desa\u2019a restoration project as a World Restoration Flagship despite ongoing conflict.",
      "key_points": [
        "UNEP and FAO recognized the project on Oct. 29, 2026.",
        "The project is in Ethiopia\u2019s Tigray region in the Great Rift Valley.",
        "At the start in 2016, an estimated 74% of Desa\u2019a Forest had already disappeared.",
        "About 70% of the remaining forest is considered degraded."
      ],
      "why_it_matters": "It brings global support to a forest recovery effort that can protect wildlife, carbon storage, and local resilience.",
      "url": "https://news.mongabay.com/2026/11/un-recognizes-ongoing-restoration-work-inside-ethiopias-desaa-forest-amid-conflict/",
      "date": "2026-11-03",
      "image": "https://imgs.mongabay.com/wp-content/uploads/sites/20/2026/11/03094624/1_20260509_UNEP-Decade-on-Ecosystem-Restoration_Ethiopias-Great-Rift-Valley_Sosina-Mengistu_13-768x512.jpg",
      "source": "Mongabay"
    },
    {
      "headline": "Amazon Cacao Grows",
      "summary": "A new study found cacao expanding in Brazil\u2019s Amazon on long-cleared land instead of recent deforestation.",
      "key_points": [
        "Embrapa found cacao in Par\u00e1 grew to 116,436 hectares between 2022 and 2024.",
        "96% of mapped cacao in Par\u00e1 was on areas deforested before 2020.",
        "98% of mapped cacao in Rond\u00f4nia was on areas deforested before 2020.",
        "Nearly all the cacao was on old pastures and other previously cleared land."
