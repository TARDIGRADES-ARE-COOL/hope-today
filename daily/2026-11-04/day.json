    {
      "headline": "Hope Haven helps fast",
      "summary": "A new community mental health hub in Whitehaven is giving people fast, open-access support and early results are promising.",
      "key_points": [
        "Hope Haven is one of 6 pilot hubs across England.",
        "About 3,000 people used it from March to July.",
        "Nearly half had never used NHS mental health services before.",
        "Inpatient ward admissions in the area fell 24% from January to September."
      ],
      "why_it_matters": "Early, local care can reach people sooner and ease pressure on overstretched mental health services.",
      "url": "https://www.theguardian.com/society/2026/nov/03/early-feedback-pilot-community-mental-health-hub-cumbria-whitehaven",
      "date": "2026-11-03",
      "image": "https://media.guim.co.uk/afec1c7fb7b7ff154a369cb45e020609e10262bf/1209_0_6830_5464/1000.jpg",
      "source": "The Guardian"
    },
    {
      "headline": "Cash for coexistence",
      "summary": "Two rural Botswana villages are being paid for living alongside wildlife through a new camera-based compensation scheme.",
      "key_points": [
        "The scheme covers Gogomoga and Tsutsubega.",
        "Each village has fewer than 500 residents.",
        "Residents use cameras to document elephants, lions and other animals.",
        "The program is run by Wild Impact and &Beyond."
      ],
      "why_it_matters": "Paying communities for coexistence can reduce conflict and support conservation at the same time.",
      "url": "https://news.mongabay.com/short-article/2026/11/payment-scheme-in-botswana-pays-communities-to-coexist-with-wildlife/",
      "date": "2026-11-03",
      "image": "https://imgs.mongabay.com/wp-content/uploads/sites/20/2026/11/03122155/Pic-1-Harmony-with-Wildlife-story-768x512.png",
      "source": "Mongabay"
    },
    {
      "headline": "Shared care village",
      "summary": "An English village has built a social care model based on communal living and shared responsibility.",
      "key_points": [
        "The story is set in a village in England.",
        "The model is built around communal living.",
        "It relies on shared responsibility for social care."
      ],
      "why_it_matters": "Community-led care can help people support one another in ways formal services often cannot.",
      "url": "https://www.positive.news/society/what-if-we-stopped-treating-social-care-like-a-service/",
      "date": "2026-11-03",
      "image": null,
      "source": "Positive News"
    },
    {
      "headline": "Women grow green work",
